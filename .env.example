# ─── LLM (OpenRouter) ─────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500

# ─── arXiv fetching ───────────────────────────────────────
ARXIV_MAX_RESULTS=50
FETCH_CATEGORIES=cs.CL,cs.AI,cs.LG,cs.CV,cs.RO,cs.NE,cs.IR,cs.MA,cs.HC,cs.MM,cs.SD
ENABLE_FULL_TEXT_EXTRACTION=false

# ─── Database ─────────────────────────────────────────────
# Default: SQLite (good for beta). Production: switch to Postgres.
DATABASE_URL=sqlite:///data/arxiv_papers.db
# DATABASE_URL=postgresql+psycopg2://researchradar:researchradar@localhost:5432/researchradar

# ─── SMTP (access-code email) ─────────────────────────────
# If unset, signup still works and the access code is shown in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FrontierOS <noreply@yourdomain.com>
APP_BASE_URL=http://localhost:8000

# ─── Personal memory backend (Mem0) ───────────────────────
# local | qdrant | disabled
MEMORY_BACKEND=local
MEMORY_STRICT=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=researchradar_mem0
# Mem0 embeddings need a real OpenAI-compatible embeddings endpoint:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Memory search ────────────────────────────────────────
# false → keyword/hybrid-lite (no extra deps). true → local embeddings.
ENABLE_LOCAL_EMBEDDINGS=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
